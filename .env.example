# Copie este arquivo para .env e ajuste os valores
DATABASE_URL="file:./data.db"

# Senha para acessar o app. Deixe em branco para desativar a tela de login.
# Quando definida, o app fica protegido por senha. iOS Safari oferece salvar
# no Keychain e abre com Face ID nos próximos acessos.
APP_PASSWORD=
